# Copie para `.env.local` e preencha conforme necessário.
# `.env.local` é ignorado pelo git — nunca commite segredos.

# --- Captura de e-mail (opcional) ---
# Escolha UMA das opções abaixo. Sem nenhuma, o formulário funciona como no-op
# gracioso (valida e responde sucesso, mas não armazena em lugar nenhum).

# Opção A — Webhook genérico (Zapier / Make / n8n / endpoint próprio).
# Recebe POST { email, source } e decide o que fazer.
# SUBSCRIBE_WEBHOOK_URL="https://hooks.exemplo.com/seu-webhook"

# Opção B — Resend (adiciona contato a uma audience).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
# RESEND_AUDIENCE_ID="00000000-0000-0000-0000-000000000000"
